# Postgres (Neon / Supabase free tier works well)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/meridian?sslmode=require"

# Long random string (generate: openssl rand -base64 32)
SESSION_SECRET="change-me"

# --- Optional: everything below can stay empty while you develop ---

# Email (https://resend.com). Needs a domain you own for EMAIL_FROM. Empty = emails are printed in the terminal.
RESEND_API_KEY=""
EMAIL_FROM="Meridian Bank <no-reply@yourdomain.com>"

# Live chat (https://crisp.chat). Paste your Website ID. Empty = no chat bubble.
NEXT_PUBLIC_CRISP_WEBSITE_ID=""

# Secret for the daily dormancy job: GET /api/cron/dormancy with header "Authorization: Bearer <value>"
CRON_SECRET=""
